      "lines": [
        { "id": "holo-zero-welcome", "role": "zero", "text": "这里是星网，你的光的身体在这里。" },
        { "id": "holo-count", "role": "narrator", "text": "再点一盏。跟着声音数。一，二，三，四，五，六，七，八，九，十。", "alias": ["再点一盏。跟着声音数。"] },
        { "id": "holo-color-cyan", "role": "narrator", "text": "青" },
        { "id": "holo-color-amber", "role": "narrator", "text": "琥珀" },
        { "id": "holo-color-purple", "role": "narrator", "text": "紫" },
        { "id": "holo-color-white", "role": "narrator", "text": "白" },
        { "id": "holo-color-green", "role": "narrator", "text": "绿" },
        { "id": "holo-hint", "role": "zero", "text": "再试一次也没关系。" },
        { "id": "holo-hint-more", "role": "zero", "text": "灯亮得比光点多了。熄掉一盏再数。" },
        { "id": "holo-hint-ten", "role": "zero", "text": "找两块，加起来正好是十。", "alias": ["找两块，加起来正好是 10。"] },
        { "id": "holo-hint-twelve", "role": "zero", "text": "找两块，加起来正好是十二。", "alias": ["找两块，加起来正好是 12。"] },
        { "id": "holo-hint-math", "role": "zero", "text": "再算一次。错了也不扣东西。" },
        { "id": "holo-hint-fingers", "role": "gugu", "text": "小咕有四根手指。外星的 10 等于我们的 4。" },
        { "id": "holo-tier", "role": "narrator", "text": "这是你的星阶。只和自己比。" },
        { "id": "holo-echo", "role": "zero", "text": "这是你的第一次记录" },
        { "id": "holo-ok", "role": "narrator", "text": "点亮了。" },
        { "id": "holo-stage-count", "role": "narrator", "text": "数一数光点，点亮一样多的灯。" },
        { "id": "holo-stage-ten", "role": "narrator", "text": "找两块，加起来是十。" },
        { "id": "holo-gugu-fuel", "role": "gugu", "text": "找两块，加起来是十二。" },
        { "id": "holo-avatar", "role": "narrator", "text": "这是你的光的身体。点颜色可以换光。" },
        { "id": "holo-count-1", "role": "narrator", "text": "一" },
        { "id": "holo-count-2", "role": "narrator", "text": "二" },
        { "id": "holo-count-3", "role": "narrator", "text": "三" },
        { "id": "holo-count-4", "role": "narrator", "text": "四" },
        { "id": "holo-count-5", "role": "narrator", "text": "五" },
        { "id": "holo-count-6", "role": "narrator", "text": "六" },
        { "id": "holo-count-7", "role": "narrator", "text": "七" },
        { "id": "holo-count-8", "role": "narrator", "text": "八" },
        { "id": "holo-count-9", "role": "narrator", "text": "九" },
        { "id": "holo-count-10", "role": "narrator", "text": "十" },
        { "id": "holo-count-11", "role": "narrator", "text": "十一" },
        { "id": "holo-count-12", "role": "narrator", "text": "十二" },
        { "id": "holo-count-13", "role": "narrator", "text": "十三" },
        { "id": "holo-count-14", "role": "narrator", "text": "十四" },
        { "id": "holo-count-15", "role": "narrator", "text": "十五" },
        { "id": "holo-count-16", "role": "narrator", "text": "十六" },
        { "id": "holo-count-17", "role": "narrator", "text": "十七" },
        { "id": "holo-count-18", "role": "narrator", "text": "十八" },
        { "id": "holo-count-19", "role": "narrator", "text": "十九" },
        { "id": "holo-count-20", "role": "narrator", "text": "二十" },
        { "id": "holo-shard", "role": "gugu", "text": "这一块星星，和家里的夜空是同一张。点大星星，补上穹顶。" },
        { "id": "holo-shard-home", "role": "gugu", "text": "带着星之片回家。观星台就能看见星星。" },
        { "id": "holo-shard-north", "role": "gugu", "text": "这块在家的北边。" },
        { "id": "holo-shape", "role": "narrator", "text": "找和缺口一样的星星。" },
        { "id": "holo-force", "role": "narrator", "text": "这里跳得更高。点最高的那一层。" },
        { "id": "holo-chart", "role": "narrator", "text": "先认太阳，再认月亮。" },
        { "id": "holo-code", "role": "narrator", "text": "按颜色排队。第一盏是青色。" },
        { "id": "holo-arena", "role": "zero", "text": "三个人合在一起算。没有输赢。" },
        { "id": "holo-arena-ok", "role": "zero", "text": "看台亮了。没有输赢，也没有排名。" },
        { "id": "holo-festival", "role": "gugu", "text": "两颗月亮一起圆。这是幻想里的团圆夜。" },
        { "id": "holo-ship", "role": "gugu", "text": "咕咕号停在旁边。星图可以看，这一版还不开船。" },
        { "id": "holo-retry", "role": "zero", "text": "再点一次也没关系。" }
